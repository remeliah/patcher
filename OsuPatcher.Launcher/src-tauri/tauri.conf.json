{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu! patcher",
  "version": "0.1.0",
  "identifier": "dev.osupatcher.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "osu! patcher",
        "width": 420,
        "height": 540,
        "minWidth": 360,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../OsuPatcher.Cli/bin/Release/patcher-cli.exe": "patcher-cli.exe",
      "../../OsuPatcher.Runtime/bin/Release/OsuPatcher.Runtime.dll": "OsuPatcher.Runtime.dll",
      "../../OsuPatcher.Runtime/bin/Release/0Harmony.dll": "0Harmony.dll",
      "../../OsuPatcher.PP/target/i686-pc-windows-msvc/release/refx_ffi.dll": "refx_ffi.dll"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
